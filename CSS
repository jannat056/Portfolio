/* =========================
   RESET
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
    color: #1f2937;
    background-color: #f8fafc;
}

a {
    text-decoration: none;
    color: inherit;
}

ul {
    list-style: none;
}

img {
    display: block;
    max-width: 100%;
}


/* =========================
   NAVBAR
========================= */

header {
    position: sticky;
    top: 0;
    z-index: 1000;

    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
}

nav {
    max-width: 1200px;
    min-height: 75px;

    margin: auto;
    padding: 0 25px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo a {
    color: #2563eb;
    font-size: 28px;
    font-weight: 700;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
}

.nav-links a {
    color: #374151;
    font-size: 15px;
    font-weight: 600;

    transition: color 0.3s ease;
}

.nav-links a:hover {
    color: #2563eb;
}


/* =========================
   COMMON SECTION
========================= */

section {
    padding: 90px 8%;
}

.section-heading {
    margin-bottom: 50px;
    text-align: center;
}

.section-heading p {
    margin-bottom: 5px;

    color: #2563eb;
    font-size: 15px;
    font-weight: 600;
}

.section-heading h2 {
    color: #111827;
    font-size: 40px;
}


/* =========================
   HERO SECTION
========================= */

#home {
    max-width: 1200px;
    min-height: calc(100vh - 75px);

    margin: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 70px;
}

.hero-content {
    flex: 1;
}

.hero-greeting {
    margin-bottom: 8px;

    color: #2563eb;
    font-size: 18px;
    font-weight: 600;
}

.hero-content h1 {
    margin-bottom: 15px;

    color: #111827;
    font-size: clamp(42px, 6vw, 68px);
    line-height: 1.1;
}

.hero-content h2 {
    margin-bottom: 20px;

    color: #4b5563;
    font-size: 25px;
}

.hero-description {
    max-width: 600px;

    margin-bottom: 30px;

    color: #6b7280;
    font-size: 17px;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
}

.hero-buttons a {
    padding: 12px 25px;

    border-radius: 8px;

    font-weight: 600;

    transition: all 0.3s ease;
}

.hero-buttons a:first-child {
    background-color: #2563eb;
    color: #ffffff;
}

.hero-buttons a:first-child:hover {
    background-color: #1d4ed8;
    transform: translateY(-3px);
}

.hero-buttons a:last-child {
    border: 2px solid #2563eb;
    color: #2563eb;
}

.hero-buttons a:last-child:hover {
    background-color: #2563eb;
    color: #ffffff;
    transform: translateY(-3px);
}


/* =========================
   HERO IMAGE
========================= */

.hero-image {
    flex: 0 0 360px;
}

.hero-image img {
    width: 330px;
    height: 330px;

    margin: auto;

    object-fit: cover;

    border: 8px solid #dbeafe;
    border-radius: 50%;

    box-shadow: 0 15px 40px rgba(37, 99, 235, 0.15);
}


/* =========================
   ABOUT SECTION
========================= */

#about {
    background-color: #ffffff;
}

.about-content {
    max-width: 1100px;

    margin: auto;

    display: flex;
    align-items: center;

    gap: 70px;
}

.about-image {
    flex: 0 0 400px;
}

.about-image img {
    width: 100%;
    height: 350px;

    object-fit: cover;

    border-radius: 15px;

    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
}

.about-text {
    flex: 1;
}

.about-text p {
    margin-bottom: 18px;

    color: #6b7280;
    font-size: 16px;
}


/* =========================
   SKILLS SECTION
========================= */

.skills-container {
    max-width: 1100px;

    margin: auto;

    display: grid;
    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}

.skill-card {
    padding: 30px;

    background-color: #ffffff;

    border: 1px solid #e5e7eb;
    border-radius: 15px;

    text-align: center;

    transition: all 0.3s ease;
}

.skill-card:hover {
    border-color: #bfdbfe;

    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08);

    transform: translateY(-8px);
}

.skill-card img {
    width: 65px;
    height: 65px;

    margin: 0 auto 18px;

    object-fit: contain;
}

.skill-card h3 {
    margin-bottom: 10px;

    color: #2563eb;
    font-size: 21px;
}

.skill-card p {
    color: #6b7280;
    font-size: 15px;
}


/* =========================
   EDUCATION SECTION
========================= */

#education {
    background-color: #ffffff;
}

.education-content {
    max-width: 1050px;

    margin: auto;

    display: flex;
    align-items: center;

    gap: 60px;
}

.education-image {
    flex: 0 0 400px;
}

.education-image img {
    width: 100%;
    height: 300px;

    object-fit: cover;

    border-radius: 15px;

    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
}

.education-card {
    flex: 1;

    padding: 35px;

    background-color: #f8fafc;

    border-left: 5px solid #2563eb;
    border-radius: 10px;
}

.education-year {
    margin-bottom: 8px;

    color: #2563eb;

    font-size: 14px;
    font-weight: 700;
}

.education-card h3 {
    margin-bottom: 8px;

    color: #111827;
    font-size: 25px;
}

.education-card h4 {
    margin-bottom: 8px;

    color: #2563eb;
    font-size: 19px;
}

.education-card p {
    margin-bottom: 6px;

    color: #6b7280;
}


/* =========================
   PROJECTS SECTION
========================= */

.projects-container {
    max-width: 1100px;

    margin: auto;

    display: grid;
    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}

.project-card {
    overflow: hidden;

    background-color: #ffffff;

    border: 1px solid #e5e7eb;
    border-radius: 15px;

    transition: all 0.3s ease;
}

.project-card:hover {
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);

    transform: translateY(-8px);
}

.project-image {
    width: 100%;
    height: 210px;

    overflow: hidden;
}

.project-image img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform 0.4s ease;
}

.project-card:hover .project-image img {
    transform: scale(1.05);
}

.project-content {
    padding: 28px;
}

.project-number {
    margin-bottom: 8px;

    color: #2563eb;

    font-size: 14px;
    font-weight: 700;
}

.project-content h3 {
    margin-bottom: 12px;

    color: #111827;
    font-size: 23px;
}

.project-content > p:not(.project-number) {
    margin-bottom: 18px;

    color: #6b7280;
    font-size: 15px;
}

.project-tech {
    display: flex;
    flex-wrap: wrap;

    gap: 8px;

    margin-bottom: 20px;
}

.project-tech span {
    padding: 5px 10px;

    background-color: #dbeafe;
    color: #1d4ed8;

    border-radius: 5px;

    font-size: 13px;
    font-weight: 600;
}

.project-content > a {
    color: #2563eb;
    font-weight: 600;

    transition: color 0.3s ease;
}

.project-content > a:hover {
    color: #1d4ed8;
}


/* =========================
   CONTACT SECTION
========================= */

#contact {
    background-color: #ffffff;
}

.contact-content {
    max-width: 1100px;

    margin: 0 auto 50px;

    display: flex;
    align-items: center;

    gap: 60px;
}

.contact-image {
    flex: 0 0 350px;
}

.contact-image img {
    width: 100%;
    height: 300px;

    object-fit: cover;

    border-radius: 15px;

    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
}

.contact-details {
    flex: 1;
}

.contact-details > p {
    margin-bottom: 25px;

    color: #6b7280;
    font-size: 16px;
}

.contact-info {
    display: grid;
    grid-template-columns: repeat(2, 1fr);

    gap: 15px;
}

.contact-item {
    padding: 20px;

    background-color: #f8fafc;

    border: 1px solid #e5e7eb;
    border-radius: 10px;
}

.contact-item h3 {
    margin-bottom: 5px;

    color: #111827;
    font-size: 17px;
}

.contact-item a {
    color: #2563eb;
    font-size: 14px;

    word-break: break-word;
}


/* =========================
   CONTACT FORM
========================= */

.contact-form {
    max-width: 700px;

    margin: auto;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;

    margin-bottom: 7px;

    color: #374151;
    font-weight: 600;
}

.form-group input,
.form-group textarea {
    width: 100%;

    padding: 13px 15px;

    border: 1px solid #d1d5db;
    border-radius: 8px;

    outline: none;

    font-family: inherit;
    font-size: 15px;

    transition: all 0.3s ease;
}

.form-group input:focus,
.form-group textarea:focus {
    border-color: #2563eb;

    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

.form-group textarea {
    resize: vertical;
}

.contact-form button {
    padding: 13px 28px;

    border: none;
    border-radius: 8px;

    background-color: #2563eb;
    color: #ffffff;

    font-size: 15px;
    font-weight: 600;

    cursor: pointer;

    transition: all 0.3s ease;
}

.contact-form button:hover {
    background-color: #1d4ed8;

    transform: translateY(-2px);
}


/* =========================
   FOOTER
========================= */

footer {
    padding: 30px 20px;

    background-color: #111827;

    color: #d1d5db;

    text-align: center;
}

footer p {
    margin-bottom: 5px;

    font-size: 14px;
}


/* =========================
   TABLET
========================= */

@media (max-width: 900px) {

    section {
        padding: 70px 5%;
    }

    #home {
        flex-direction: column-reverse;

        padding-top: 70px;
        padding-bottom: 70px;

        text-align: center;
    }

    .hero-description {
        margin-right: auto;
        margin-left: auto;
    }

    .hero-buttons {
        justify-content: center;
    }

    .hero-image {
        flex: auto;
    }

    .about-content,
    .education-content,
    .contact-content {
        flex-direction: column;
    }

    .about-image,
    .education-image,
    .contact-image {
        width: 100%;
        max-width: 500px;

        flex: auto;
    }

    .about-text {
        text-align: center;
    }

    .skills-container {
        grid-template-columns: repeat(2, 1fr);
    }

    .projects-container {
        grid-template-columns: repeat(2, 1fr);
    }

    .education-card,
    .contact-details {
        width: 100%;
    }
}


/* =========================
   MOBILE
========================= */

@media (max-width: 600px) {

    nav {
        min-height: auto;

        padding: 20px;

        flex-direction: column;

        gap: 15px;
    }

    .nav-links {
        gap: 12px;

        justify-content: center;

        flex-wrap: wrap;
    }

    .nav-links a {
        font-size: 13px;
    }

    section {
        padding: 60px 5%;
    }

    #home {
        min-height: auto;
    }

    .hero-image img {
        width: 230px;
        height: 230px;
    }

    .hero-content h1 {
        font-size: 40px;
    }

    .hero-content h2 {
        font-size: 20px;
    }

    .hero-description {
        font-size: 15px;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .hero-buttons a {
        width: 100%;

        text-align: center;
    }

    .section-heading {
        margin-bottom: 35px;
    }

    .section-heading h2 {
        font-size: 32px;
    }

    .skills-container,
    .projects-container,
    .contact-info {
        grid-template-columns: 1fr;
    }

    .about-image img,
    .education-image img,
    .contact-image img {
        height: 250px;
    }

    .education-card {
        padding: 25px;
    }

    .education-card h3 {
        font-size: 21px;
    }

    .project-image {
        height: 200px;
    }
}